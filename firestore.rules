rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The browser never talks to Firestore: every read and write goes through server
    // routes using the Admin SDK, which bypasses these rules. Allowing client writes
    // let any signed-in user set their own subscription tier, reset their run count,
    // or create panels with arbitrary run config.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
